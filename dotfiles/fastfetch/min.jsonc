{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/etc/nixos/dotfiles/fastfetch/cat.png",
        "type": "kitty",
        "height": 13,
        "width": 25,
        "padding": {
            "top": 0,
            "left": 0
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
         {
            "type": "title",
            "key": " ",
            "keyColor": "red",
            "color": {
                "user": "magenta",
                "at": "magenta",
                "host": "magenta"
            }
        },
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS:",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 :",
            "keyColor": "red"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 :",
            "keyColor": "red"
        },
        {
            "type": "shell",
            "key": "│ ├󰞷 :",
            "keyColor": "red"
        },
        {
            "type": "terminal",
            "key": "│ ├󰆍 :",
            "keyColor": "red"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 :",
            "keyColor": "red"
        },
        {
            "type": "uptime",
            "key": "└ └󰜷 :",
            "keyColor": "red"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────┘"
        },
        "break"
    ]
}
